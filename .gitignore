# =====================================================================
# Claude Code
# =====================================================================
# The whole folder stays local. It holds agent definitions, skills, the
# housekeeper's scratchpad and machine-local settings — none of which are
# part of the published component or the docs site.
.claude/

# =====================================================================
# Python
# =====================================================================
__pycache__/
*.py[cod]
*$py.class
*.so

