{
  "name": "dash_excalidraw",
  "version": "0.1.0",
  "description": "Excalidraw drawing component for Dash 3+ / Excalidraw 0.18.x",
  "main": "index.ts",
  "repository": {
    "type": "git",
    "url": "git://github.com/pip-install-python/dash-excalidraw.git"
  },
  "bugs": {
    "url": "https://github.com/pip-install-python/dash-excalidraw/issues"
  },
  "homepage": "https://github.com/pip-install-python/dash-excalidraw",
  "scripts": {
    "build:js::dev": "webpack --mode development",
    "build:js": "webpack",
    "build:backends": "dash-generate-components ./src/ts/components dash_excalidraw -p package-info.json --ignore \\.test\\. -t dash_excalidraw.dash_prop_typing",
    "build": "npm run build:js && npm run build:backends",
    "watch": "npm run build:js::dev -- --watch",
    "dist": "python -m build --sdist --wheel --outdir dist/",
    "format": "prettier --write src --ignore-path=.prettierignore"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "css-loader": "^6.10.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.2.4",
    "react": "18.3.1",
    "react-docgen": "^5.4.3",
    "react-dom": "18.3.1",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.5.1",
    "typescript": "^5.6.3",
    "webpack": "^5.97.0",
    "webpack-cli": "^5.1.4"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "author": "Pip Install Python <pipinstallpython@gmail.com>",
  "license": "MIT"
}
