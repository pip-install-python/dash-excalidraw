# dash-excalidraw — local environment
#
# Copy to `.env` and fill in. `.env` is gitignored and must never be
# committed. Names below are read out of the code that consumes them —
# keep this file in sync when you add a new `os.environ.get(...)`.
#
# NOTHING here is required to run the showcase. Every AI page degrades
# to a disabled-provider state when its key is absent, which is also
# the posture CI runs in (secretless: integrations must fail closed).

# ---------------------------------------------------------------------
# AI scene generation — pages/ai_agent.py
# ---------------------------------------------------------------------

# Claude provider. Absent -> the Claude provider is disabled on the page.
# pages/ai_agent.py:203
ANTHROPIC_API_KEY=

# Gemini provider. Absent -> the Gemini provider is disabled on the page.
# pages/ai_agent.py:204,325
GEMINI_API_KEY=

# Fallback read only when GEMINI_API_KEY is unset. Same value, older name.
# pages/ai_agent.py:205,325
GOOGLE_API_KEY=
