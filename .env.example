# dash-excalidraw — local environment
#
# Copy to `.env` and fill in what you need. `.env` is gitignored and must never
# be committed. Every name below is read by code in this repo — keep this file
# in sync when you add a new `os.environ.get(...)`.
#
# NOTHING here is required to run the site locally. Every integration fails
# closed when its variable is absent, which is also the posture the test suite
# runs in: `pytest tests` passes with the entire environment stripped, and that
# is the point — it proves no feature silently depends on a secret.
#
# The PACKAGE (`pip install dash-excalidraw`) reads none of these. They belong
# to the documentation site only.

# =====================================================================
# Public origin — the highest-consequence value here
# =====================================================================
# Drives <link rel="canonical">, sitemap.xml and the absolute URLs in
# llms.txt. Unset in production the app REFUSES TO BOOT (see
# lib/constants.require_owned_base_url), because inheriting the boilerplate's
# default would tell Google this whole site is a duplicate of the template.
# Leave unset locally.
APP_BASE_URL=https://excalidraw.2plot.dev

# =====================================================================
# AI scene generation — docs/ai-agent/ai_agent.py
# =====================================================================
# The /ai-agent page ships behind the `auth` tier precisely because these keys
# cost money per generation. Absent, each provider is disabled on the page and
# the UI says so.

# Claude provider. pages read it at docs/ai-agent/ai_agent.py
ANTHROPIC_API_KEY=

# Gemini provider.
GEMINI_API_KEY=

# Fallback read only when GEMINI_API_KEY is unset. Same value, older name.
GOOGLE_API_KEY=

# =====================================================================
# Network identity (lib/bulletin.py, lib/ad_client.py, lib/hub_client.py)
# =====================================================================
# ONE short id on every hub surface — the directory key, not a long name.
# render.yaml sets both to the same value for exactly this reason.
SATELLITE_APP_KEY=excalidraw
AD_APP_ID=excalidraw

# Hub-published announcements rendered in the llms.txt viewer header. Unset,
# the header still renders with an empty state — no error either way, so the
# boot line "network bulletin: ..." is how you tell which state you are in.
# NOTE: on Render this must be set on the SERVICE. Blueprint envVars apply on
# Blueprint sync, not on git-push autodeploys.
NETWORK_BULLETIN_URL=https://2plot.dev/api/network/bulletin

# Signs the traffic rollup POSTed to 2plot.ai. Unset, reporting is off and
# the app says so at startup. THE shared secret: hub and satellite must hold
# the identical value or verification fails silently as an "invalid
# signature" 400.
CROSS_APP_WEBHOOK_SECRET=

# --- Reporting cadence and the two persistent stores -------------------
# In production all six come from the `2plot-satellite-reporting` env group.
# Both file paths live on the 1 GB disk mounted at /var/data; the app prints
# a [visibility] WARNING at boot naming exactly which half is missing, and
# the ABSENCE of that line is the acceptance check.
SATELLITE_TRAFFIC_URL=https://2plot.ai/api/satellite/traffic
# 15 minutes, not the code default of hourly: the fleet is on paid instances
# and the hub board reads near-real-time.
SATELLITE_REPORT_INTERVAL_S=900
SATELLITE_REPORT_DELAY_S=90
# The separate presence beacon behind the hub's live "active now" count.
# 0 disables it; the hub contract floors it at 30s.
SATELLITE_PRESENCE_INTERVAL_S=60
# Locally these default to the repo directory, which is fine and gitignored.
# TRAFFIC_ANALYTICS_FILE=/var/data/visitor_analytics.json
# PAGE_VISIBILITY_FILE=/var/data/page_visibility.json

# =====================================================================
# The interactive gate (lib/gate_layouts.py, lib/access.py)
# =====================================================================
# Who may read a docs page in a BROWSER. Set it to `auth` and every page
# whose frontmatter does not pin a tier shows the sign-in card to anonymous
# visitors. Rollback is setting it back — env only, no code change.
#
# `/` and the corpus pseudo-paths are pinned public in run.py and never
# inherit this. /ai-agent pins `tier: auth` in its own frontmatter because it
# spends real API credits, and is gated regardless of what this says.
PAGE_DEFAULT_TIER=public

# The tiers of the two corpus documents, registered in run.py with an
# explicit fallback so they never inherit PAGE_DEFAULT_TIER: gating the
# interactive site must not silently gate /llms-small.txt and /llms-full.txt.
LLMS_SMALL_TIER=public
LLMS_FULL_TIER=public

# The SECOND axis, and the phase-4 agent flip. Deliberately left UNSET
# fleet-wide: unset behaves as open, which is the data-window posture —
# machine surfaces (the llms.txt family, crawler HTML, the prerender) keep
# serving prose on `auth` pages so crawl demand stays measurable while humans
# meet the gate. Setting it to 0 gates anonymous machine fetches too (keyed
# agents still pass). Its first appearance on a host IS the flip.
# LLMS_PUBLIC_DEFAULT=1

# =====================================================================
# Clerk authentication — lib/auth.py, gates pages with `tier: auth`
# =====================================================================
# Fully optional: with none of these set, register() is a no-op and the auth
# tier fails CLOSED (the gate document is served to everyone), so nothing is
# left exposed by leaving it off.
#
# vendor/ ships dash-clerk-auth 1.0.5, the fleet line. The floor is 0.9.2 —
# 0.9.1 and earlier call the Clerk MODAL from the Sign In button, which a
# satellite rejects with "This operation is not allowed on a satellite
# domain" — but this host takes 1.0.5 directly: it is the release that
# reconciles the RETURN TRIP (landing back on a gated page after signing in
# on the primary used to show the gate card until a manual refresh).
#
# In production these come from the `2plot-clerk-satellite` env group, not
# from a service-level copy — see render.yaml for why that distinction is
# load-bearing. The values below are that group's, written out so a local
# run can mirror production exactly.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SIGN_IN_URL=https://accounts.2plot.ai/sign-in
CLERK_SIGN_UP_URL=https://accounts.2plot.ai/sign-up
# REQUIRED on a satellite — a production custom-domain instance cannot derive
# it from CLERK_SIGN_IN_URL.
CLERK_FRONTEND_API=https://clerk.2plot.ai
# "true" in production only. Clerk rejects satellite mode on localhost.
CLERK_IS_SATELLITE=false
# The REGISTERED SATELLITE DOMAIN — deliberately NOT this host, and NOT the
# host in APP_BASE_URL. Every *.2plot.dev docs site is an ALLOWED SUBDOMAIN of
# the one 2plot.dev satellite; `clerk.excalidraw.2plot.dev` is NXDOMAIN and
# setting this to excalidraw.2plot.dev hangs sign-in with no error. Session
# cookies are scoped to .2plot.dev, which is exactly what the allowlist buys.
CLERK_SATELLITE_DOMAIN=2plot.dev
# THE RETURN TRIP. Unset, dash-clerk-auth's buildSatelliteRedirect() returns
# null, sign-in falls through to the Clerk Account Portal, and the user
# authenticates successfully and STAYS on the primary — no error anywhere.
# A DESTINATION, not a flag: the value is concatenated as
# `<value>?returnTo=<here>`, so `true` or a bare host resolves against THIS
# site and the Sign In button 404s — worse than unset. lib/auth.py prints a
# [auth] WARNING at boot for both mistakes, and the ABSENCE of those two
# lines in a deploy log is the acceptance check for this variable.
CLERK_SATELLITE_SIGN_IN_REDIRECT=https://2plot.ai/onboarding
# Allowlist for `admin`-tier pages (/admin/control-board). Comma-separated.
# Unset in production, admin surfaces fail CLOSED.
ADMIN_EMAILS=
# Signs the Flask session and the __dca_identity cookie. Without it
# dash-clerk-auth falls back to a PUBLIC dev default string. UNIQUE per
# deployment — never shared, never grouped.
SESSION_SECRET=

# =====================================================================
# Runtime knobs
# =====================================================================
# flask | fastapi | quart. FastAPI and Quart also need the matching dash extra
# and an ASGI start command, so changing this alone is not enough.
DASH_BACKEND=flask

# Dash 4.3+ MCP server. Off by default: a live introspection surface on a
# public host.
DASH_MCP_ENABLED=0

# Background callbacks for /ai-agent and /benchmark (lib/background.py).
# Unset: ON on Linux (where Render runs), OFF on macOS — the forked diskcache
# worker is killed there without raising, and the page waits forever for a job
# that is already gone. `on` opts in on macOS anyway; `off` runs the model
# call inside the request, which blocks a gunicorn worker for its duration.
# BACKGROUND_CALLBACKS=
# Where diskcache keeps transient job state. Defaults to the system temp dir
# and is deliberately NOT on the persistent disk: this is job state that must
# not survive a restart.
# BACKGROUND_CACHE_DIR=

# Bounds on the anonymous upload store behind /file-uploads (lib/file_store.py).
# Defaults suit a 512 MB container; raise them if you have the headroom.
# EXCALIDRAW_FILE_MAX_ENTRY_BYTES=5242880
# EXCALIDRAW_FILE_MAX_TOTAL_BYTES=67108864
# EXCALIDRAW_FILE_TTL_SECONDS=3600
